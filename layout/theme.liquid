<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary | default: '#4D5943' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    <!-- Google Fonts: Cormorant Garamond & Montserrat -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS Engine for Utility Architecture -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: {
                sand: '#F7F4F0',
                cream: '#FAF9F6',
                olive: '#4D5943',
                darkOlive: '#3E4836',
                charcoal: '#222222',
                muted: '#71717A',
                border: '#E5E2DC'
              }
            },
            fontFamily: {
              serif: ['"Cormorant Garamond"', 'serif'],
              sans: ['"Montserrat"', 'sans-serif']
            }
          }
        }
      }
    </script>

    <!-- Theme Custom CSS -->
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {%- if page_title -%}
      <title>{{ page_title }} &ndash; {{ shop.name }}</title>
    {%- else -%}
      <title>THREADORA | Timeless Style, Modern You</title>
    {%- endif -%}

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body class="antialiased text-brand-charcoal bg-white flex flex-col min-h-screen">
    <!-- Skip to content for accessibility -->
    <a class="sr-only focus:not-sr-only focus:absolute focus:p-4 focus:bg-white focus:z-50" href="#MainContent">
      Skip to content
    </a>

    <!-- Header Section Group -->
    {% sections 'header-group' %}
    {% section 'announcement-bar' %}
    {% section 'header' %}

    <!-- Mobile Navigation Drawer Overlay & Content -->
    <div id="MobileNavOverlay" class="cart-drawer-overlay"></div>
    <div id="MobileNavDrawer" class="mobile-nav-drawer">
      <div class="flex items-center justify-between pb-4 border-b border-brand-border mb-4">
        <span class="font-serif-heading text-lg font-bold">THREADORA</span>
        <button id="MobileNavClose" class="text-xl p-2">&times;</button>
      </div>
      <nav class="flex flex-col space-y-1">
        <a href="/" class="mobile-nav-link">Home</a>
        <a href="/collections/all" class="mobile-nav-link">Shop All</a>
        <a href="/collections" class="mobile-nav-link">Collections</a>
        <a href="/pages/about-us" class="mobile-nav-link">About Us</a>
        <a href="/blogs/news" class="mobile-nav-link">Journal & Blog</a>
        <a href="/pages/contact" class="mobile-nav-link">Contact</a>
      </nav>
      <div class="mt-auto pt-6 border-t border-brand-border text-xs text-neutral-500">
        <p class="font-semibold text-neutral-800 mb-1">Customer Support</p>
        <p>support@threadora.com</p>
      </div>
    </div>

    <!-- Main Content -->
    <main id="MainContent" class="flex-grow focus:outline-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Footer Section Group -->
    {% section 'footer' %}
    {% sections 'footer-group' %}

    <!-- Slide-out Cart Drawer -->
    {% render 'cart-drawer' %}

    <!-- Toast Notification Container -->
    <div id="ToastContainer" class="toast-container"></div>

    <!-- Theme Core JavaScript -->
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
