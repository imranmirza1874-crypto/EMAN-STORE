<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }} &ndash; Opening Soon</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="bg-[#FAF9F6] text-[#222222] min-h-screen flex items-center justify-center p-6">
    <div class="max-w-md w-full text-center bg-white p-8 md:p-12 shadow-md border border-[#E5E2DC]">
      <h1 class="font-serif text-3xl md:text-4xl uppercase tracking-widest font-semibold mb-2">THREADORA</h1>
      <p class="text-xs uppercase tracking-widest text-neutral-500 mb-6">Timeless Style, Modern You</p>
      <div class="w-12 h-[1px] bg-neutral-800 mx-auto mb-6"></div>
      <p class="text-sm text-neutral-600 mb-8 leading-relaxed">We are preparing our new seasonal collection. Enter your store password below to gain early access.</p>
      
      {{ content_for_layout }}
      
      <p class="text-[11px] text-neutral-400 mt-8">&copy; {{ 'now' | date: '%Y' }} THREADORA. All Rights Reserved.</p>
    </div>
  </body>
</html>
