<section class="relative bg-[#EEEBE5] overflow-hidden" data-purpose="hero-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 lg:py-28 flex flex-col md:flex-row items-center justify-between">
    <!-- Hero Textual Content -->
    <div class="w-full md:w-1/2 z-10 pr-0 md:pr-8 mb-10 md:mb-0">
      <span class="text-xs uppercase tracking-[0.25em] text-neutral-500 font-semibold mb-3 block">
        {{ section.settings.badge | default: 'New Season, New Style' }}
      </span>
      <h1 class="font-serif-heading text-4xl sm:text-5xl lg:text-6xl text-neutral-900 font-normal leading-[1.1] mb-5 tracking-tight uppercase">
        {{ section.settings.title | default: 'EFFORTLESS STYLE<br>EVERY DAY' }}
      </h1>
      <p class="text-neutral-600 text-sm md:text-base font-light max-w-sm mb-8 leading-relaxed">
        {{ section.settings.description | default: 'Discover modern essentials crafted for comfort, quality, and timeless elegance.' }}
      </p>
      <a class="inline-block bg-[#4D5943] hover:bg-[#3E4836] text-white text-xs uppercase font-semibold tracking-widest px-8 py-3.5 transition-all shadow-sm"
         href="{{ section.settings.button_link | default: '/collections/all' }}">
        {{ section.settings.button_label | default: 'SHOP NOW' }}
      </a>
    </div>

    <!-- Hero Image Presentation -->
    <div class="w-full md:w-1/2 flex justify-center md:justify-end relative">
      <div class="relative w-full max-w-md md:max-w-lg aspect-[4/5] rounded overflow-hidden shadow-sm">
        {%- if section.settings.image != blank -%}
          <img 
            src="{{ section.settings.image | image_url: width: 1000 }}" 
            alt="{{ section.settings.image.alt | default: 'Threadora Hero Image' | escape }}" 
            class="w-full h-full object-cover object-top"
            loading="eager"
            width="1000"
            height="1250"
          >
        {%- else -%}
          <img 
            alt="Woman in relaxed modern linen outfit" 
            class="w-full h-full object-cover object-top" 
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuBTtDnli_mJsiUNAK_pz7bfhFFI5AQlxs8pCphMbi0TwmnltGlDnRwU0wB4S4v8Ln-xgobswRqsRi9cgcIHtkGLOBs45gLjqmUcGghykoW5icBnCFceBO4qNyYOZYd4L8xKrtoRh6vp4aIl7PUYXoOZfaGNBqV35z-0FhcPKoXPtcGZoOLqwUBrHDxCu4S_e35Dg_nKE-Ga9g_n_EQtRDW0zPNgO8jSKRKThJVgV_r4iz4FyGm_NzAE"
            loading="eager"
          />
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Small Top Badge",
      "default": "New Season, New Style"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading Title",
      "default": "EFFORTLESS STYLE<br>EVERY DAY"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Discover modern essentials crafted for comfort, quality, and timeless elegance."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
