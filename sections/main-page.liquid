{% comment %}
  Main Page Section for Threadora Theme
{% endcomment %}

<section class="py-12 md:py-16 bg-white">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <h1 class="font-serif-heading text-3xl sm:text-4xl text-neutral-900 uppercase">
        {{ page.title | default: 'About Threadora' }}
      </h1>
      <div class="w-12 h-[1px] bg-neutral-800 mx-auto mt-3"></div>
    </div>

    <div class="prose max-w-none text-sm text-neutral-700 leading-relaxed space-y-4">
      {{ page.content | default: '<p>Threadora was born from a belief that personal style should feel timeless, effortless, and thoughtfully made. Every piece in our collection is designed with intention—combining breathable natural fibers, relaxed silhouettes, and mindful craftsmanship built to last.</p>' }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Page",
  "settings": []
}
{% endschema %}
