<section class="py-16 bg-white" data-purpose="product-showcase">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title Header -->
    <div class="text-center mb-12">
      <h2 class="font-serif-heading text-2xl sm:text-3xl text-neutral-900 uppercase font-medium tracking-widest">
        {{ section.settings.title | default: 'NEW ARRIVALS' }}
      </h2>
      <div class="w-12 h-[1px] bg-neutral-800 mx-auto mt-2"></div>
    </div>

    <!-- Product Cards Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-x-4 gap-y-8 lg:gap-x-6">
      {%- assign featured_collection = collections[section.settings.collection] -%}
      {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
        {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
          {% render 'card-product', card_product: product %}
        {%- endfor -%}
      {%- else -%}
        <!-- Product 1: Linen Blend Shirt Dress -->
        <div class="product-card group relative flex flex-col" data-product-id="1">
          <div class="relative w-full aspect-[3/4] bg-neutral-100 overflow-hidden mb-3">
            <img alt="Linen Blend Shirt Dress" class="w-full h-full object-cover object-top transition duration-300 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBBBEowAv6nO3m8dN9Nl8nhvoHW86COW0DNZh90J_KseCOsXl8JNKWNunio7YmrKPtif706uLL8uEfviBo1PXLDYZhdb885bMJl635pwc2S94M2rMByeHLPgVro22MIghSohsVYdWNNR56Q0eUbciOBEzYGi2e2VazgabwKyvN4WJ_dfqAfMPcldTiwwuluaq1ulbUj1dLayn22_vhifTS_3n2BFh9zDIKLHteydLLKFyDn4MDPEMtE"/>
            <button aria-label="Add to wishlist" class="product-card__wishlist-btn" data-wishlist-btn>
              {% render 'icon-heart' %}
            </button>
            <button type="button" class="product-card__quick-add" data-quick-add data-product-id="1" data-product-title="Linen Blend Shirt Dress" data-product-price="54.99" data-product-image="https://lh3.googleusercontent.com/aida-public/AB6AXuBBBEowAv6nO3m8dN9Nl8nhvoHW86COW0DNZh90J_KseCOsXl8JNKWNunio7YmrKPtif706uLL8uEfviBo1PXLDYZhdb885bMJl635pwc2S94M2rMByeHLPgVro22MIghSohsVYdWNNR56Q0eUbciOBEzYGi2e2VazgabwKyvN4WJ_dfqAfMPcldTiwwuluaq1ulbUj1dLayn22_vhifTS_3n2BFh9zDIKLHteydLLKFyDn4MDPEMtE" data-product-variant="Sage / M">
              + Quick Add
            </button>
          </div>
          <h3 class="text-xs text-neutral-800 font-medium tracking-tight mb-1">Linen Blend Shirt Dress</h3>
          <span class="text-xs font-semibold text-neutral-900 mb-2">$54.99</span>
          <div class="color-swatches flex space-x-1.5">
            <span class="color-swatch active w-2.5 h-2.5 rounded-full bg-[#CBD5C0] border border-neutral-300 inline-block cursor-pointer"></span>
            <span class="color-swatch w-2.5 h-2.5 rounded-full bg-[#E5DFD4] border border-neutral-300 inline-block cursor-pointer"></span>
            <span class="color-swatch w-2.5 h-2.5 rounded-full bg-[#1F2022] border border-neutral-300 inline-block cursor-pointer"></span>
          </div>
        </div>

        <!-- Product 2: Oversized Knit Sweater -->
        <div class="product-card group relative flex flex-col" data-product-id="2">
          <div class="relative w-full aspect-[3/4] bg-neutral-100 overflow-hidden mb-3">
            <img alt="Oversized Knit Sweater" class="w-full h-full object-cover object-top transition duration-300 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuA8R7jGLN2LmCqv2Yva8g2PxvO0vulL5YwlY5CxhAMusUaPEPQfcDQHXY00PV_LJNJepepFNvhf7prcZAOIp6hMkQFrmVs0mVH7gMCxp4jIwjDntfsWLjzjrAUT75L6NMtFFz5bZ8MeoM4BGYzoN2gfrLwiDTLlk7RS1onJsKgmPif0gD0xwm48FZS-WXhyMD3QZxX2NivFKARIZBRnAvLK_R-KTfFi8cTIwZMmmqin3ADpQ-Idv6Mp"/>
            <button aria-label="Add to wishlist" class="product-card__wishlist-btn" data-wishlist-btn>
              {% render 'icon-heart' %}
            </button>
            <button type="button" class="product-card__quick-add" data-quick-add data-product-id="2" data-product-title="Oversized Knit Sweater" data-product-price="48.99" data-product-image="https://lh3.googleusercontent.com/aida-public/AB6AXuA8R7jGLN2LmCqv2Yva8g2PxvO0vulL5YwlY5CxhAMusUaPEPQfcDQHXY00PV_LJNJepepFNvhf7prcZAOIp6hMkQFrmVs0mVH7gMCxp4jIwjDntfsWLjzjrAUT75L6NMtFFz5bZ8MeoM4BGYzoN2gfrLwiDTLlk7RS1onJsKgmPif0gD0xwm48FZS-WXhyMD3QZxX2NivFKARIZBRnAvLK_R-KTfFi8cTIwZMmmqin3ADpQ-Idv6Mp" data-product-variant="Oatmeal / L">
              + Quick Add
            </button>
          </div>
          <h3 class="text-xs text-neutral-800 font-medium tracking-tight mb-1">Oversized Knit Sweater</h3>
          <span class="text-xs font-semibold text-neutral-900 mb-2">$48.99</span>
          <div class="color-swatches flex space-x-1.5">
            <span class="color-swatch active w-2.5 h-2.5 rounded-full bg-[#D7C2B2] border border-neutral-300 inline-block cursor-pointer"></span>
            <span class="color-swatch w-2.5 h-2.5 rounded-full bg-[#C79986] border border-neutral-300 inline-block cursor-pointer"></span>
            <span class="color-swatch w-2.5 h-2.5 rounded-full bg-[#B2B9B8] border border-neutral-300 inline-block cursor-pointer"></span>
          </div>
        </div>

        <!-- Product 3: Tailored Wide Leg Pants -->
        <div class="product-card group relative flex flex-col" data-product-id="3">
          <div class="relative w-full aspect-[3/4] bg-neutral-100 overflow-hidden mb-3">
            <img alt="Tailored Wide Leg Pants" class="w-full h-full object-cover object-top transition duration-300 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBgOLAX-RwQmzKMT-zpN9a8SE3DQWI-JcGJ22IJie134Z20DFhC74T4AGl4JCOFZp29om-hywXt3J533IO91TKk_gPMxLuUYnho5etSPneBlu7o5oxFYj9I55bDZanfopbMoe_auMIr-Fn9ktMJxmQ9I0dKl3VKNrsmCZRf81eYs5AyJ5dnTPpItiPp2iKFWtzk9GoOzeXhnRZ9cbzfMAS_-VGCOi1rLLBpAWyJpNy8Ze59Xu15LYCy"/>
            <button aria-label="Add to wishlist" class="product-card__wishlist-btn" data-wishlist-btn>
              {% render 'icon-heart' %}
            </button>
            <button type="button" class="product-card__quick-add" data-quick-add data-product-id="3" data-product-title="Tailored Wide Leg Pants" data-product-price="59.99" data-product-image="https://lh3.googleusercontent.com/aida-public/AB6AXuBgOLAX-RwQmzKMT-zpN9a8SE3DQWI-JcGJ22IJie134Z20DFhC74T4AGl4JCOFZp29om-hywXt3J533IO91TKk_gPMxLuUYnho5etSPneBlu7o5oxFYj9I55bDZanfopbMoe_auMIr-Fn9ktMJxmQ9I0dKl3VKNrsmCZRf81eYs5AyJ5dnTPpItiPp2iKFWtzk9GoOzeXhnRZ9cbzfMAS_-VGCOi1rLLBpAWyJpNy8Ze59Xu15LYCy" data-product-variant="Sand / 28">
              + Quick Add
            </button>
          </div>
          <h3 class="text-xs text-neutral-800 font-medium tracking-tight mb-1">Tailored Wide Leg Pants</h3>
          <span class="text-xs font-semibold text-neutral-900 mb-2">$59.99</span>
          <div class="color-swatches flex space-x-1.5">
            <span class="color-swatch active w-2.5 h-2.5 rounded-full bg-[#CEC3B4] border border-neutral-300 inline-block cursor-pointer"></span>
            <span class="color-swatch w-2.5 h-2.5 rounded-full bg-[#8E847B] border border-neutral-300 inline-block cursor-pointer"></span>
            <span class="color-swatch w-2.5 h-2.5 rounded-full bg-[#111111] border border-neutral-300 inline-block cursor-pointer"></span>
          </div>
        </div>

        <!-- Product 4: Ribbed Tank Top -->
        <div class="product-card group relative flex flex-col" data-product-id="4">
          <div class="relative w-full aspect-[3/4] bg-neutral-100 overflow-hidden mb-3">
            <img alt="Ribbed Tank Top" class="w-full h-full object-cover object-top transition duration-300 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB3sZ9unyUDppDycNa_njh_o52jL6zuLRi-P7cvT9CvEdhjlMQeuPYafql4T9PgKDOuXhG45L3gQguBlmNZ5C6vobB25Q2YHInNj0c-HbeCYlTz1rjPthRlZLCIvC7VRuGJM2JPpHgogvpo7kozhpQ3n_zxrBT1iMotktXnaG8FM7QcVLV_1KhkTQW6ozczZMTPL-tW55xAvPPli_I1o9yrc4WiAA2sweadol2ZKEbqrDcFry9vObiA"/>
            <button aria-label="Add to wishlist" class="product-card__wishlist-btn" data-wishlist-btn>
              {% render 'icon-heart' %}
            </button>
            <button type="button" class="product-card__quick-add" data-quick-add data-product-id="4" data-product-title="Ribbed Tank Top" data-product-price="24.99" data-product-image="https://lh3.googleusercontent.com/aida-public/AB6AXuB3sZ9unyUDppDycNa_njh_o52jL6zuLRi-P7cvT9CvEdhjlMQeuPYafql4T9PgKDOuXhG45L3gQguBlmNZ5C6vobB25Q2YHInNj0c-HbeCYlTz1rjPthRlZLCIvC7VRuGJM2JPpHgogvpo7kozhpQ3n_zxrBT1iMotktXnaG8FM7QcVLV_1KhkTQW6ozczZMTPL-tW55xAvPPli_I1o9yrc4WiAA2sweadol2ZKEbqrDcFry9vObiA" data-product-variant="Sage / S">
              + Quick Add
            </button>
          </div>
          <h3 class="text-xs text-neutral-800 font-medium tracking-tight mb-1">Ribbed Tank Top</h3>
          <span class="text-xs font-semibold text-neutral-900 mb-2">$24.99</span>
          <div class="color-swatches flex space-x-1.5">
            <span class="color-swatch active w-2.5 h-2.5 rounded-full bg-[#D4C4B5] border border-neutral-300 inline-block cursor-pointer"></span>
            <span class="color-swatch w-2.5 h-2.5 rounded-full bg-[#7D8876] border border-neutral-300 inline-block cursor-pointer"></span>
            <span class="color-swatch w-2.5 h-2.5 rounded-full bg-[#1A1A1A] border border-neutral-300 inline-block cursor-pointer"></span>
          </div>
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "New Arrivals",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 2,
      "default": 4,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "New Arrivals"
    }
  ]
}
{% endschema %}
