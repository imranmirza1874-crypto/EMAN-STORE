<section class="border-y border-neutral-200 bg-white py-6" data-purpose="trust-badges">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 divide-y md:divide-y-0 md:divide-x divide-neutral-200">
      
      <!-- Badge 1: Free Shipping -->
      <div class="flex items-center space-x-3.5 pt-4 md:pt-0 justify-start md:justify-center">
        <svg class="w-7 h-7 stroke-neutral-700 stroke-[1.3] flex-shrink-0" fill="none" viewBox="0 0 24 24">
          <path d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8h4l3 3v5h-2m-8 0a2 2 0 104 0m-8 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <div>
          <h4 class="text-xs uppercase font-bold tracking-wider text-neutral-900">
            {{ section.settings.badge_1_title | default: 'Free Shipping' }}
          </h4>
          <p class="text-[11px] text-neutral-500 font-normal">
            {{ section.settings.badge_1_sub | default: 'On orders over $75' }}
          </p>
        </div>
      </div>

      <!-- Badge 2: Easy Returns -->
      <div class="flex items-center space-x-3.5 pt-4 md:pt-0 md:pl-6 justify-start md:justify-center">
        <svg class="w-7 h-7 stroke-neutral-700 stroke-[1.3] flex-shrink-0" fill="none" viewBox="0 0 24 24">
          <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <div>
          <h4 class="text-xs uppercase font-bold tracking-wider text-neutral-900">
            {{ section.settings.badge_2_title | default: 'Easy Returns' }}
          </h4>
          <p class="text-[11px] text-neutral-500 font-normal">
            {{ section.settings.badge_2_sub | default: '30-day return policy' }}
          </p>
        </div>
      </div>

      <!-- Badge 3: Premium Quality -->
      <div class="flex items-center space-x-3.5 pt-4 md:pt-0 md:pl-6 justify-start md:justify-center">
        <svg class="w-7 h-7 stroke-neutral-700 stroke-[1.3] flex-shrink-0" fill="none" viewBox="0 0 24 24">
          <circle cx="12" cy="8" r="6"></circle>
          <path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.723.518l-4.269-2.247-4.269 2.247a.5.5 0 0 1-.723-.518l1.515-8.526" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <div>
          <h4 class="text-xs uppercase font-bold tracking-wider text-neutral-900">
            {{ section.settings.badge_3_title | default: 'Premium Quality' }}
          </h4>
          <p class="text-[11px] text-neutral-500 font-normal">
            {{ section.settings.badge_3_sub | default: 'Carefully selected fabrics' }}
          </p>
        </div>
      </div>

      <!-- Badge 4: Secure Checkout -->
      <div class="flex items-center space-x-3.5 pt-4 md:pt-0 md:pl-6 justify-start md:justify-center">
        <svg class="w-7 h-7 stroke-neutral-700 stroke-[1.3] flex-shrink-0" fill="none" viewBox="0 0 24 24">
          <rect height="11" rx="2" ry="2" width="18" x="3" y="11"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <div>
          <h4 class="text-xs uppercase font-bold tracking-wider text-neutral-900">
            {{ section.settings.badge_4_title | default: 'Secure Checkout' }}
          </h4>
          <p class="text-[11px] text-neutral-500 font-normal">
            {{ section.settings.badge_4_sub | default: '100% safe & secure' }}
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Value Proposition Bar",
  "settings": [
    {
      "type": "text",
      "id": "badge_1_title",
      "label": "Badge 1 Title",
      "default": "Free Shipping"
    },
    {
      "type": "text",
      "id": "badge_1_sub",
      "label": "Badge 1 Subtitle",
      "default": "On orders over $75"
    },
    {
      "type": "text",
      "id": "badge_2_title",
      "label": "Badge 2 Title",
      "default": "Easy Returns"
    },
    {
      "type": "text",
      "id": "badge_2_sub",
      "label": "Badge 2 Subtitle",
      "default": "30-day return policy"
    },
    {
      "type": "text",
      "id": "badge_3_title",
      "label": "Badge 3 Title",
      "default": "Premium Quality"
    },
    {
      "type": "text",
      "id": "badge_3_sub",
      "label": "Badge 3 Subtitle",
      "default": "Carefully selected fabrics"
    },
    {
      "type": "text",
      "id": "badge_4_title",
      "label": "Badge 4 Title",
      "default": "Secure Checkout"
    },
    {
      "type": "text",
      "id": "badge_4_sub",
      "label": "Badge 4 Subtitle",
      "default": "100% safe & secure"
    }
  ],
  "presets": [
    {
      "name": "Value Proposition Bar"
    }
  ]
}
{% endschema %}
