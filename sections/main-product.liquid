{% comment %}
  Main Product Section for Threadora Theme
{% endcomment %}

<section class="py-12 md:py-16 bg-white" data-section-id="{{ section.id }}">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
      
      <!-- Product Media Gallery -->
      <div class="space-y-4">
        <div class="aspect-[3/4] bg-neutral-100 overflow-hidden relative rounded">
          {%- if product.featured_media -%}
            <img 
              id="ProductMainImage" 
              src="{{ product.featured_media | image_url: width: 1000 }}" 
              alt="{{ product.title | escape }}" 
              class="w-full h-full object-cover object-top"
            >
          {%- else -%}
            <img 
              id="ProductMainImage" 
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuBBBEowAv6nO3m8dN9Nl8nhvoHW86COW0DNZh90J_KseCOsXl8JNKWNunio7YmrKPtif706uLL8uEfviBo1PXLDYZhdb885bMJl635pwc2S94M2rMByeHLPgVro22MIghSohsVYdWNNR56Q0eUbciOBEzYGi2e2VazgabwKyvN4WJ_dfqAfMPcldTiwwuluaq1ulbUj1dLayn22_vhifTS_3n2BFh9zDIKLHteydLLKFyDn4MDPEMtE" 
              alt="Linen Blend Shirt Dress" 
              class="w-full h-full object-cover object-top"
            >
          {%- endif -%}
        </div>
      </div>

      <!-- Product Form & Details -->
      <div class="flex flex-col">
        <span class="text-xs uppercase tracking-[0.2em] text-neutral-500 font-semibold mb-2">
          {{ product.vendor | default: 'THREADORA ESSENTIALS' }}
        </span>

        <h1 class="font-serif-heading text-3xl sm:text-4xl text-neutral-900 font-normal mb-3">
          {{ product.title | default: 'Linen Blend Shirt Dress' }}
        </h1>

        <div class="flex items-center space-x-3 mb-6">
          <span class="text-xl font-bold text-neutral-900">
            {{ product.price | money | default: '$54.99' }}
          </span>
          {%- if product.compare_at_price > product.price -%}
            <span class="text-sm text-neutral-400 line-through">
              {{ product.compare_at_price | money }}
            </span>
          {%- endif -%}
        </div>

        <div class="w-full h-[1px] bg-neutral-200 mb-6"></div>

        <!-- Product Form -->
        {%- form 'product', product, id: 'product-form' -%}
          <!-- Variant Options -->
          <div class="space-y-5 mb-8">
            <!-- Color Selector -->
            <div>
              <label class="block text-xs uppercase font-bold tracking-wider text-neutral-800 mb-2">
                Color: <span class="font-normal text-neutral-500" id="SelectedColor">Sage</span>
              </label>
              <div class="color-swatches flex gap-2">
                <span class="color-swatch active w-6 h-6 rounded-full bg-[#CBD5C0] border border-neutral-300 inline-block cursor-pointer"></span>
                <span class="color-swatch w-6 h-6 rounded-full bg-[#E5DFD4] border border-neutral-300 inline-block cursor-pointer"></span>
                <span class="color-swatch w-6 h-6 rounded-full bg-[#1F2022] border border-neutral-300 inline-block cursor-pointer"></span>
              </div>
            </div>

            <!-- Size Selector -->
            <div>
              <label class="block text-xs uppercase font-bold tracking-wider text-neutral-800 mb-2">
                Size
              </label>
              <div class="flex gap-2">
                <button type="button" class="px-4 py-2 text-xs font-semibold border border-neutral-800 bg-neutral-900 text-white">S</button>
                <button type="button" class="px-4 py-2 text-xs font-semibold border border-neutral-300 text-neutral-800 hover:border-neutral-800">M</button>
                <button type="button" class="px-4 py-2 text-xs font-semibold border border-neutral-300 text-neutral-800 hover:border-neutral-800">L</button>
                <button type="button" class="px-4 py-2 text-xs font-semibold border border-neutral-300 text-neutral-800 hover:border-neutral-800">XL</button>
              </div>
            </div>
          </div>

          <!-- Quantity & Add to Cart -->
          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <button 
              type="button" 
              class="btn btn-primary flex-1 py-4 text-xs font-bold uppercase tracking-widest"
              data-quick-add
              data-product-id="{{ product.id | default: 1 }}"
              data-product-title="{{ product.title | default: 'Linen Blend Shirt Dress' }}"
              data-product-price="{{ product.price | divided_by: 100.0 | default: 54.99 }}"
              data-product-image="{{ product.featured_media | image_url: width: 200 | default: 'https://lh3.googleusercontent.com/aida-public/AB6AXuBBBEowAv6nO3m8dN9Nl8nhvoHW86COW0DNZh90J_KseCOsXl8JNKWNunio7YmrKPtif706uLL8uEfviBo1PXLDYZhdb885bMJl635pwc2S94M2rMByeHLPgVro22MIghSohsVYdWNNR56Q0eUbciOBEzYGi2e2VazgabwKyvN4WJ_dfqAfMPcldTiwwuluaq1ulbUj1dLayn22_vhifTS_3n2BFh9zDIKLHteydLLKFyDn4MDPEMtE' }}"
            >
              Add to Bag
            </button>
          </div>
        {%- endform -%}

        <!-- Description Accordion -->
        <div class="border-t border-neutral-200 divide-y divide-neutral-200 text-xs text-neutral-600">
          <details class="py-4 cursor-pointer" open>
            <summary class="font-semibold text-neutral-900 uppercase tracking-wider">Description & Fit</summary>
            <p class="mt-3 leading-relaxed">
              {{ product.description | default: 'Crafted from a premium linen-cotton blend, this relaxed shirt dress offers all-day comfort with elevated effortless style. Features buttoned cuffs, a chest pocket, and a clean classic collar.' }}
            </p>
          </details>
          <details class="py-4 cursor-pointer">
            <summary class="font-semibold text-neutral-900 uppercase tracking-wider">Materials & Care</summary>
            <p class="mt-3 leading-relaxed">
              70% Certified Organic Linen, 30% Cotton. Machine wash cold with like colors. Line dry recommended to preserve fabric longevity.
            </p>
          </details>
          <details class="py-4 cursor-pointer">
            <summary class="font-semibold text-neutral-900 uppercase tracking-wider">Shipping & Free Returns</summary>
            <p class="mt-3 leading-relaxed">
              Free standard shipping on orders over $75. Hassle-free 30-day return policy on all unworn items with tags attached.
            </p>
          </details>
        </div>

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "label": "Enable Sticky Product Details",
      "default": true
    }
  ]
}
{% endschema %}
