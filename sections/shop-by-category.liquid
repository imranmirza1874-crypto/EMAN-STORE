        {%- endif -%}
        <div class="relative z-10 w-full text-center">
          <span class="font-serif-heading text-base md:text-lg uppercase text-neutral-900 tracking-wider font-semibold block mb-2">
            {{ section.settings.cat_3_title | default: 'BOTTOMS' }}
          </span>
          <a class="inline-block bg-white/95 hover:bg-white text-[10px] uppercase font-bold tracking-widest px-4 py-2 text-neutral-900 transition"
             href="{{ section.settings.cat_3_link | default: '/collections/bottoms' }}">
            SHOP NOW
          </a>
        </div>
      </div>

      <!-- Category 4: Accessories -->
      <div class="relative group aspect-[4/5] bg-neutral-100 overflow-hidden flex items-end p-4">
        {%- if section.settings.cat_4_image != blank -%}
          <img src="{{ section.settings.cat_4_image | image_url: width: 600 }}" alt="{{ section.settings.cat_4_title | escape }}" class="absolute inset-0 w-full h-full object-cover transition duration-300 group-hover:scale-105">
        {%- else -%}
          <img alt="Accessories collection" class="absolute inset-0 w-full h-full object-cover transition duration-300 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAD5NzV56Y9x3I3Ex9CtDTW8RVZu3Nnpk_X75U1eZJvWU9N7VDk3MBY-yJCEk9E38yhTKfDUECL-uvzIwXdi2uYDDuK6622sw3UMEH5Sc-c_YCGVHeaPN83NJhbZP50CCZyPp2gU2u88eFP6n55wLGVe1X8BugRUMPhRY-AoKPjhJD1-zDpOotkIL6wSf520v1XtIB59wRWlbRpLo1j-qL5WAXY0U5F5TRrrr4GrK8MTgpnF-mYC43n"/>
        {%- endif -%}
        <div class="relative z-10 w-full text-center">
          <span class="font-serif-heading text-base md:text-lg uppercase text-neutral-900 tracking-wider font-semibold block mb-2">
            {{ section.settings.cat_4_title | default: 'ACCESSORIES' }}
          </span>
          <a class="inline-block bg-white/95 hover:bg-white text-[10px] uppercase font-bold tracking-widest px-4 py-2 text-neutral-900 transition"
             href="{{ section.settings.cat_4_link | default: '/collections/accessories' }}">
            SHOP NOW
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

